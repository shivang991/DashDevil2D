map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 8081;
    server_name localhost;
    access_log off;
    location = /healthz {
        default_type text/plain;
        return 200 'ok\n';
    }
    location / { return 404; }
}


server {
    listen 443 ssl;
    server_name ${PUBLIC_HOST};
    server_tokens off;
    ssl_certificate /etc/letsencrypt/live/dashdevil/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dashdevil/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 64k;

    # Admission URLs contain bearer tickets. Do not write them to access/error logs.
    access_log off;
    error_log /var/log/nginx/error.log crit;

    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream https://server:8443;
    proxy_set_header Host ${PUBLIC_HOST};
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_ssl_server_name on;
    proxy_ssl_name ${PUBLIC_HOST};
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_ssl_verify_depth 3;

    location = /admission {
        proxy_pass $api_upstream;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
    }

    location = /room {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        # Setting headers at this level replaces inherited proxy_set_header values.
        proxy_set_header Host ${PUBLIC_HOST};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # HTTP/3 extended CONNECT reaches Go directly over public UDP 443.
    # An ordinary TCP request here is not a WebTransport connection.
    location = /gameplay { return 426; }

    location / {
        proxy_pass http://client:8080;
    }
}
