# DNS hostname only; no scheme, port, or trailing slash.
# Point its A (and any AAAA) record at your VPC host before running up.sh.
PUBLIC_HOST=play.example.com
ACME_EMAIL=you@example.com

# Planned maintenance: stop new admissions/starts, allow active rounds to finish.
DRAIN_TIMEOUT=3m
# Must exceed DRAIN_TIMEOUT by at least 15 seconds (delivery + process shutdown).
STOP_GRACE_PERIOD=200s
